@inject WalletStateService Wallet

<section class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="p-4 border-bottom">
            <h2 class="h5 mb-0">Lịch sử giao dịch</h2>
        </div>

        @if (Wallet.Transactions.Count == 0)
        {
            <p class="text-center text-secondary py-5 mb-0">Chưa có giao dịch nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Loại giao dịch</th>
                            <th>Số tiền</th>
                            <th class="pe-4">Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Wallet.Transactions)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold @transaction.TypeClass">@transaction.TypeText</td>
                                <td>@transaction.Amount.ToString("N0") đ</td>
                                <td class="pe-4 text-secondary">@transaction.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@implements IDisposable

@code {
    protected override void OnInitialized()
    {
        Wallet.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Wallet.OnChange -= StateHasChanged;
    }
}
